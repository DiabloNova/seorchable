# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Application runtime connection. Used by all API routes, server actions and tests
# that simulate runtime behaviour.
DATABASE_URL=

# Migration-only connection. NEVER referenced from application runtime code,
# API routes, client code, or Vercel runtime configuration.
MIGRATION_DATABASE_URL=
STAGING_MIGRATION_DATABASE_URL=

# ---------------------------------------------------------------------------
# Session security (REQUIRED IN PRODUCTION)
# ---------------------------------------------------------------------------
# HMAC key for the signed session cookie. Minimum 32 characters.
# The application THROWS at runtime in production when this is missing, because a
# per-process random secret causes cross-instance session verification failures
# (random logouts) in any serverless or horizontally scaled deployment.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Rate limiting / cache (REQUIRED IN PRODUCTION)
# ---------------------------------------------------------------------------
# Upstash Redis backs the distributed rate limiter that protects the metered
# endpoints (free audit, premium audit, crawler start). Metered routes FAIL CLOSED
# with 503 in production when these are absent.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# External services
# ---------------------------------------------------------------------------
# Web crawling. Audit endpoints return 503 in production when unset; they never
# fall back to fabricated crawl results.
FIRECRAWL_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# Shared secret for the payment webhook. Compared with crypto.timingSafeEqual.
PAYMENT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Application behaviour
# ---------------------------------------------------------------------------
DATA_SOURCE=db

# Controls robots.txt: only "production" allows indexing. Preview and staging
# deployments must NOT be set to production.
NEXT_PUBLIC_APP_ENV=development
